# ------------------------------------------------------------
# 1. Frozen variables
# ------------------------------------------------------------
OUTCOME_VAR <- "bjp_vote_share_2014"
BASELINE_BJP_VAR <- "bjp_vote_share_2009"
BASELINE_FDI_VAR <- "log1p_fdi_mfg_local_all_pc100k_2009"
CURRENT_FDI_COUNT_VAR <- "fdi_mfg_local_all_n_2014"
MUSLIM_VAR <- "muslim_share_2001_dist_proxy"
CENTER_VAR <- "nes_weighted_share_center_among_ideology_complete_2009"
CENTER_N_VAR <- "nes_n_ideology_complete_2009"
CENTER_MIN_N <- 5L
C1_VARS <- c("proxy_ac_pop", "con08_land_area", "sc_pop_share", "st_pop_share")

# ------------------------------------------------------------
# 2. Load and validate data
# ------------------------------------------------------------
ac_change <- readRDS(file.path(paths$final_dir, "ac_change.rds"))
ac_year <- readRDS(file.path(paths$final_dir, "ac_year.rds"))

if (!CENTER_N_VAR %in% names(ac_change)) {
  center_n_payload <- ac_year |>
    dplyr::filter(year == 2009) |>
    dplyr::transmute(
      ac_uid,
      nes_n_ideology_complete_2009 = nes_n_ideology_complete
    ) |>
    dplyr::distinct(ac_uid, .keep_all = TRUE)

  ac_change <- ac_change |>
    dplyr::left_join(
      center_n_payload,
      by = "ac_uid",
      relationship = "one-to-one"
    )
}

required <- c(
  "ac_uid", "state_no", "pc_cluster_id",
  OUTCOME_VAR, BASELINE_BJP_VAR, BASELINE_FDI_VAR,
  CURRENT_FDI_COUNT_VAR, MUSLIM_VAR, CENTER_VAR, CENTER_N_VAR,
  C1_VARS
)
missing <- setdiff(required, names(ac_change))
if (length(missing)) stop("Missing required ac_change variables: ", paste(missing, collapse = ", "))

# ------------------------------------------------------------
# 3. Informative-unit rulers (same convention as paper pipeline)
# ------------------------------------------------------------
median_positive <- function(x) {
  z <- as.numeric(x)
  z <- z[is.finite(z) & z > 0]
  if (!length(z)) return(NA_real_)
  stats::median(z)
}

median_or_positive <- function(x) {
  z <- as.numeric(x)
  z <- z[is.finite(z)]
  if (!length(z)) return(list(value = NA_real_, rule = "missing"))
  med <- stats::median(z)
  if (is.finite(med) && med > 0) return(list(value = med, rule = "ordinary median"))
  list(value = median_positive(z), rule = "median positive fallback")
}

ac14 <- ac_year |>
  dplyr::filter(year == 2014) |>
  dplyr::distinct(ac_uid, .keep_all = TRUE)

if (!"log1p_fdi_mfg_local_all_pc100k" %in% names(ac14)) {
  stop("ac_year lacks log1p_fdi_mfg_local_all_pc100k for the common FDI ruler.")
}
if (!MUSLIM_VAR %in% names(ac14)) {
  stop("ac_year lacks ", MUSLIM_VAR, " for the Muslim ruler.")
}

REF_FDI <- median_positive(ac14$log1p_fdi_mfg_local_all_pc100k)
MUSLIM_REF_OBJ <- median_or_positive(ac14[[MUSLIM_VAR]])
REF_MUSLIM <- MUSLIM_REF_OBJ$value

center_ref_data <- ac_change |>
  dplyr::filter(
    !is.na(.data[[CENTER_N_VAR]]),
    .data[[CENTER_N_VAR]] >= CENTER_MIN_N,
    is.finite(.data[[CENTER_VAR]])
  )
CENTER_REF_OBJ <- median_or_positive(center_ref_data[[CENTER_VAR]])
REF_CENTER <- CENTER_REF_OBJ$value

if (any(!is.finite(c(REF_FDI, REF_MUSLIM, REF_CENTER))) ||
    any(c(REF_FDI, REF_MUSLIM, REF_CENTER) <= 0)) {
  stop("One or more informative-unit rulers are missing/nonpositive.")
}

rulers <- tibble::tibble(
  quantity = c("Manufacturing FDI", "Muslim share 2001", "Weighted AC Center share 2009"),
  low = 0,
  high = c(REF_FDI, REF_MUSLIM, REF_CENTER),
  rule = c(
    "median positive among unique 2014 ACs",
    MUSLIM_REF_OBJ$rule,
    paste0(CENTER_REF_OBJ$rule, "; Center N >= ", CENTER_MIN_N)
  )
)
message("Informative-unit rulers:")
print(rulers, n = Inf, width = Inf)

